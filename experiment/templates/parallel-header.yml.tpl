# ---------------------------------------------------------------------------
# TEMPLATE for Config E (Cached+Parallel). Generated by
#   python experiment/generate-workflows.py
#
# Config E differs from B (Cached) in ONE factor: lint and test run as separate
# jobs instead of sequential steps. On GitHub Actions a job is a fresh virtual
# machine, so each job must install dependencies itself. That is not an
# artefact of this design but the real cost of parallelising a pipeline here,
# and it is why "Parallel without caching" is not one of the configurations:
# without a cache it would measure duplicated installation rather than
# parallelisation.
#
# The test job runs the suite exactly as B does (one process). E and B differ
# in how the STAGES are distributed, not in how the tests are run.
#
# CONSEQUENCE FOR ANALYSIS. A run's total energy is the SUM over its three
# jobs, and its wall-clock time is the LONGEST path, not the sum. Every result
# row therefore carries a `job` column.
# ---------------------------------------------------------------------------
name: Pipeline - Config E (Cached+Parallel)

on:
  workflow_dispatch:
    inputs:
      required_cpu:
        description: 'Confirmatory round: run only on this processor (e.g. EPYC 7763). Empty accepts any.'
        required: false
        default: ''

permissions:
  contents: read
  actions: write   # the processor gate cancels its own run

env:
  CONFIG_ID: 'E'
  SUBJECT_UPSTREAM_SHA: e55f9f0e43b022a8db6e5aac4e6d8aa247a11399
